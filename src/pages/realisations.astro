---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Placeholder from "../components/Placeholder.astro";
import CtaBand from "../components/CtaBand.astro";
---
<BaseLayout title="Past realisations">
  <PageHeader title="Past realisations" badge="Phase 2" lead="Projects built by the community. Requires real user projects." />
  <section class="block">
    <div class="wrap grid g3">
      {[1, 2, 3, 4, 5, 6].map((n) => <Placeholder kind="figure" label={`Project ${n} — photo`} h="190px" />)}
    </div>
  </section>
  <section class="block">
    <div class="wrap">
      <Placeholder label="Submit your project" h="100px" />
      <p><a href="/contact">Contact us →</a> · <a href="/how-it-works">How it works →</a></p>
    </div>
  </section>
  <CtaBand />
</BaseLayout>
