---
// Root "/" only redirects to the visitor's language (saved choice, browser language, else English).
import { site } from "../config/site";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{site.name}</title>
    {site.noindex && <meta name="robots" content="noindex, nofollow" />}
    <noscript><meta http-equiv="refresh" content="0; url=/en" /></noscript>
    <script is:inline>
      (function () {
        var known = ["en", "fr", "it"], pick = "en";
        try {
          var saved = localStorage.getItem("lang");
          var nav = (navigator.language || "en").slice(0, 2);
          pick = saved && known.indexOf(saved) > -1 ? saved : known.indexOf(nav) > -1 ? nav : "en";
        } catch (e) {}
        location.replace("/" + pick + location.search + location.hash);
      })();
    </script>
  </head>
  <body>
    <p><a href="/en">English</a> · <a href="/fr">Français</a> · <a href="/it">Italiano</a></p>
  </body>
</html>
