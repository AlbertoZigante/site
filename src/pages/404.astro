---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { locales, defaultLocale, t } from "../i18n";
// Static 404 has no locale in its URL: render every language, show the visitor's one via script.
---
<BaseLayout lang={defaultLocale} title={t(defaultLocale, "page.notFound.title")} altPath="/" error>
  {locales.map((lang) => (
    <div data-lang={lang} hidden={lang !== defaultLocale}>
      <PageHeader title={t(lang, "page.notFound.title")} lead={t(lang, "page.notFound.lead")} />
      <section class="block"><div class="wrap"><a class="btn" href={`/${lang}`}>{t(lang, "action.backHome")}</a></div></section>
    </div>
  ))}
</BaseLayout>
<script>
  const known = ["en", "fr", "it"];
  let pick = "en";
  try {
    const saved = localStorage.getItem("lang");
    const nav = (navigator.language || "en").slice(0, 2);
    pick = saved && known.includes(saved) ? saved : known.includes(nav) ? nav : "en";
  } catch {}
  document.querySelectorAll<HTMLElement>("[data-lang]").forEach((el) => { el.hidden = el.dataset.lang !== pick; });
  document.documentElement.lang = pick;
</script>
