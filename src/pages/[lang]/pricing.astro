---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import Placeholder from "../../components/Placeholder.astro";
import CtaBand from "../../components/CtaBand.astro";
import { useI18n, localePaths, type Locale } from "../../i18n";
export const getStaticPaths = localePaths;
const lang = Astro.params.lang as Locale;
const { t, l } = useI18n(lang);
---
<BaseLayout lang={lang} title={t("page.pricing.title")}>
  <PageHeader title={t("page.pricing.title")} lead={t("page.pricing.lead")} />
  <section class="block">
    <div class="wrap grid g3">
      <Placeholder label="Plan — Free" h="320px" />
      <Placeholder label="Plan — Pro" h="320px" />
      <Placeholder label="Plan — Joiner (B2B)" h="320px" href={l("/joiners")} />
    </div>
  </section>
  <section class="block">
    <div class="wrap">
      <Placeholder label="Plan comparison table" h="220px" />
      <p><a href={l("/legal/cgv")}>{t("link.cgv")}</a> · <a href={l("/contact")}>{t("link.questions")}</a></p>
    </div>
  </section>
  <CtaBand lang={lang} secondaryLabel={t("nav.features")} secondaryHref="/features" />
</BaseLayout>
