---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import Placeholder from "../../components/Placeholder.astro";
import CtaBand from "../../components/CtaBand.astro";
import { useI18n, localePaths, type Locale } from "../../i18n";
export const getStaticPaths = localePaths;
const lang = Astro.params.lang as Locale;
const { t, l } = useI18n(lang);
---
<BaseLayout lang={lang} title={t("page.howItWorks.title")}>
  <PageHeader title={t("page.howItWorks.title")} lead={t("page.howItWorks.lead")} />
  {[1, 2, 3].map((n) => (
    <section class="block">
      <div class="wrap grid g2">
        <Placeholder label={`Step ${n} — text`} h="220px" />
        <Placeholder kind="figure" label={`Step ${n} — figure`} h="220px" />
      </div>
    </section>
  ))}
  <section class="block">
    <div class="wrap">
      <Placeholder label="FAQ / what you get (PDF, cut list, BOM)" h="160px" />
      <p><a href={l("/features")}>{t("link.seeAllFeatures")}</a> · <a href={l("/delivery-suppliers")}>{t("link.delivery")}</a></p>
    </div>
  </section>
  <CtaBand lang={lang} secondaryLabel={t("nav.features")} secondaryHref="/features" />
</BaseLayout>
