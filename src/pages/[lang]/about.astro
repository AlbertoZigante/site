---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import Placeholder from "../../components/Placeholder.astro";
import CtaBand from "../../components/CtaBand.astro";
import { useI18n, localePaths, type Locale } from "../../i18n";
export const getStaticPaths = localePaths;
const lang = Astro.params.lang as Locale;
const { t, l } = useI18n(lang);
---
<BaseLayout lang={lang} title={t("page.about.title")}>
  <PageHeader title={t("page.about.title")} lead={t("page.about.lead")} />
  <section class="block">
    <div class="wrap grid g2">
      <Placeholder label="Story / mission — text" h="260px" />
      <Placeholder kind="figure" label="Founder / workshop photo" h="260px" />
    </div>
  </section>
  <section class="block">
    <div class="wrap">
      <Placeholder label="Values / roadmap" h="140px" />
      <p><a href={l("/contact")}>{t("link.contact")}</a> · <a href={l("/legal/notice")}>{t("link.legalNotice")}</a> · <a href={l("/how-it-works")}>{t("link.howItWorks")}</a></p>
    </div>
  </section>
</BaseLayout>
