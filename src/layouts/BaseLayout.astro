---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../config/site";
import { locales, localePath, splitLocale, useI18n, type Locale } from "../i18n";
interface Props {
  lang: Locale;
  title: string;
  description?: string;
  /** Locale-less path used by the language switcher; defaults to the current page. */
  altPath?: string;
  /** Error pages (404): no hreflang alternates. */
  error?: boolean;
}
const { lang, title, description, altPath, error = false } = Astro.props;
const { t } = useI18n(lang);
const rest = altPath ?? splitLocale(Astro.url.pathname).rest;
const full = title === site.name ? title : `${title} — ${site.name}`;
const desc = description ?? t("meta.tagline");
const abs = (p: string) => new URL(p, Astro.site ?? Astro.url).href;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={desc} />
    {site.noindex && <meta name="robots" content="noindex, nofollow" />}
    {!error && locales.map((l) => <link rel="alternate" hreflang={l} href={abs(localePath(l, rest))} />)}
    {!error && <link rel="alternate" hreflang="x-default" href={abs("/")} />}
    <script is:inline>try{document.documentElement.dataset.auth=localStorage.getItem("dm_session")?"in":"out"}catch(e){}</script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <Header lang={lang} rest={rest} />
    <main><slot /></main>
    <Footer lang={lang} />
  </body>
</html>
