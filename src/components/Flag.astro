---
import type { Locale } from "../i18n";
interface Props { lang: Locale; }
const { lang } = Astro.props;
---
<span class="flag" aria-hidden="true">
  {lang === "en" && (
    <svg viewBox="0 0 60 40" preserveAspectRatio="none" focusable="false">
      <rect width="60" height="40" fill="#012169" />
      <path d="M0 0L60 40M60 0L0 40" stroke="#fff" stroke-width="8" />
      <path d="M0 0L60 40M60 0L0 40" stroke="#C8102E" stroke-width="3" />
      <path d="M30 0V40M0 20H60" stroke="#fff" stroke-width="12" />
      <path d="M30 0V40M0 20H60" stroke="#C8102E" stroke-width="7" />
    </svg>
  )}
  {lang === "fr" && (
    <svg viewBox="0 0 60 40" preserveAspectRatio="none" focusable="false">
      <rect width="20" height="40" fill="#0055A4" /><rect x="20" width="20" height="40" fill="#fff" /><rect x="40" width="20" height="40" fill="#EF4135" />
    </svg>
  )}
  {lang === "it" && (
    <svg viewBox="0 0 60 40" preserveAspectRatio="none" focusable="false">
      <rect width="20" height="40" fill="#009246" /><rect x="20" width="20" height="40" fill="#fff" /><rect x="40" width="20" height="40" fill="#CE2B37" />
    </svg>
  )}
</span>
