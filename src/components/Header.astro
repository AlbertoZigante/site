---
import { site, nav } from "../config/site";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/">{site.name}</a>
    <nav class="nav" aria-label="Main">
      {nav.map((g) => (
        <div class="nav-group" tabindex="0">
          <span>{g.label} ▾</span>
          <div class="menu">
            {g.items.map((i) => (
              <a href={i.href} aria-current={path === i.href ? "page" : undefined}>
                {i.label}{i.phase2 && <span class="badge">Phase 2</span>}
              </a>
            ))}
          </div>
        </div>
      ))}
      <a class="btn" href={site.appUrl}>Open the modeller</a>
    </nav>
  </div>
</header>
