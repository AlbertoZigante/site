+/* Header dropdowns (language, account): same behaviour as the nav menus, overlaid so the header never resizes */
+.lang-dd, .account { outline: none; }
+.lang-menu, .account-dd { left: auto; right: 0; min-width: 160px; }
+.lang-cur { display: inline-flex; align-items: center; gap: .35rem; cursor: pointer; }
+.nav-group > .icon-btn { cursor: pointer; }
+.lang-menu a { display: flex; align-items: center; gap: .55rem; }
+.account-dd button { display: block; width: 100%; text-align: left; padding: .35rem .9rem;
+  border: 0; background: none; font: inherit; color: inherit; cursor: pointer; }
+.account-dd button:hover { background: var(--ph-bg); }
+.flag { display: inline-block; flex: none; width: 22px; height: 15px; border-radius: 2px; overflow: hidden;
