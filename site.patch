diff --git a/src/components/AccountMenu.astro b/src/components/AccountMenu.astro
new file mode 100644
index 0000000..9a940f1
--- /dev/null
+++ b/src/components/AccountMenu.astro
@@ -0,0 +1,46 @@
+---
+import { dashboardLink } from "../config/site";
+import { useI18n, type Locale } from "../i18n";
+interface Props { lang: Locale; }
+const { lang } = Astro.props;
+const { t, l } = useI18n(lang);
+---
+<div class="account" id="account-menu" data-connect={l("/connect")} data-home={l("/")}>
+  <button class="icon-btn" type="button" id="account-btn" aria-haspopup="menu" aria-expanded="false"
+    title={t("action.account")} aria-label={t("action.account")}>
+    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
+      <circle cx="12" cy="8" r="4" /><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7" />
+    </svg>
+  </button>
+  <div class="menu account-dd" id="account-dd" role="menu" hidden>
+    <a class="if-out" role="menuitem" id="connect-link" href={l("/connect")}>{t("action.connect")}</a>
+    <a class="if-in" role="menuitem" href={l("/account")}>{t("action.info")}</a>
+    <a class="if-in" role="menuitem" href={dashboardLink(lang)}>{t("action.dashboard")}</a>
+    <a class="if-in" role="menuitem" href={l("/settings")}>{t("action.settings")}</a>
+    <button class="if-in" role="menuitem" type="button" id="disconnect-btn">{t("action.disconnect")}</button>
+  </div>
+</div>
+<script>
+  const root = document.getElementById("account-menu")!;
+  const btn = document.getElementById("account-btn")!;
+  const dd = document.getElementById("account-dd")!;
+  const close = () => { dd.hidden = true; btn.setAttribute("aria-expanded", "false"); };
+  btn.addEventListener("click", () => {
+    const open = dd.hidden;
+    dd.hidden = !open;
+    btn.setAttribute("aria-expanded", String(open));
+  });
+  document.addEventListener("click", (e) => { if (!root.contains(e.target as Node)) close(); });
+  document.addEventListener("keydown", (e) => { if (e.key === "Escape") close(); });
+
+  // Come back to the current page after connecting.
+  const connect = document.getElementById("connect-link") as HTMLAnchorElement;
+  connect.href = `${root.dataset.connect}?next=${encodeURIComponent(location.pathname)}`;
+
+  document.getElementById("disconnect-btn")!.addEventListener("click", () => {
+    try { localStorage.removeItem("dm_session"); } catch {}
+    document.documentElement.dataset.auth = "out";
+    close();
+    location.href = root.dataset.home!;
+  });
+</script>
