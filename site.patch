diff --git a/src/pages/[lang]/account.astro b/src/pages/[lang]/account.astro
new file mode 100644
index 0000000..57d7968
--- /dev/null
+++ b/src/pages/[lang]/account.astro
@@ -0,0 +1,29 @@
+---
+import BaseLayout from "../../layouts/BaseLayout.astro";
+import PageHeader from "../../components/PageHeader.astro";
+import { useI18n, localePaths, type Locale } from "../../i18n";
+export const getStaticPaths = localePaths;
+const lang = Astro.params.lang as Locale;
+const { t, l } = useI18n(lang);
+---
+<BaseLayout lang={lang} title={t("page.account.title")}>
+  <PageHeader title={t("page.account.title")} lead={t("page.account.lead")} />
+  <section class="block">
+    <div class="wrap">
+      <dl class="kv" id="account-info" data-connect={l("/connect")}>
+        <dt>{t("page.account.name")}</dt><dd id="acc-name">—</dd>
+        <dt>{t("page.account.email")}</dt><dd id="acc-email">—</dd>
+      </dl>
+    </div>
+  </section>
+</BaseLayout>
+<script>
+  const box = document.getElementById("account-info")!;
+  let s: { name?: string; email?: string } | null = null;
+  try { s = JSON.parse(localStorage.getItem("dm_session") ?? "null"); } catch {}
+  if (!s) location.replace(`${box.dataset.connect}?next=${encodeURIComponent(location.pathname)}`);
+  else {
+    document.getElementById("acc-name")!.textContent = s.name ?? "—";
+    document.getElementById("acc-email")!.textContent = s.email ?? "—";
+  }
+</script>
diff --git a/src/pages/[lang]/connect.astro b/src/pages/[lang]/connect.astro
new file mode 100644
index 0000000..fd31df3
--- /dev/null
+++ b/src/pages/[lang]/connect.astro
@@ -0,0 +1,34 @@
+---
+import BaseLayout from "../../layouts/BaseLayout.astro";
+import PageHeader from "../../components/PageHeader.astro";
+import { useI18n, localePaths, type Locale } from "../../i18n";
+export const getStaticPaths = localePaths;
+const lang = Astro.params.lang as Locale;
+const { t, l } = useI18n(lang);
+---
+<BaseLayout lang={lang} title={t("page.connect.title")}>
+  <PageHeader title={t("page.connect.title")} lead={t("page.connect.lead")} />
+  <section class="block">
+    <div class="wrap">
+      <form class="auth-form" id="connect-form" data-home={l("/")}>
+        <label>{t("page.connect.name")}<input name="name" required autocomplete="name" /></label>
+        <label>{t("page.connect.email")}<input name="email" type="email" required autocomplete="email" /></label>
+        <button type="submit">{t("page.connect.submit")}</button>
+      </form>
+    </div>
+  </section>
+</BaseLayout>
+<script>
+  const form = document.getElementById("connect-form") as HTMLFormElement;
+  form.addEventListener("submit", (e) => {
+    e.preventDefault();
+    const d = new FormData(form);
+    try {
+      localStorage.setItem("dm_session", JSON.stringify({ name: String(d.get("name")), email: String(d.get("email")) }));
+    } catch {}
+    document.documentElement.dataset.auth = "in";
+    // Only same-site paths are accepted as the return target.
+    const next = new URLSearchParams(location.search).get("next") ?? "";
+    location.href = /^\/(?!\/)/.test(next) && !next.endsWith("/connect") ? next : form.dataset.home!;
+  });
+</script>
diff --git a/src/pages/[lang]/settings.astro b/src/pages/[lang]/settings.astro
new file mode 100644
index 0000000..5b3639d
--- /dev/null
+++ b/src/pages/[lang]/settings.astro
@@ -0,0 +1,21 @@
+---
+import BaseLayout from "../../layouts/BaseLayout.astro";
+import PageHeader from "../../components/PageHeader.astro";
+import { locales, localeNames, localePath, useI18n, localePaths, type Locale } from "../../i18n";
+export const getStaticPaths = localePaths;
+const lang = Astro.params.lang as Locale;
+const { t, l } = useI18n(lang);
+---
+<BaseLayout lang={lang} title={t("page.settings.title")}>
+  <PageHeader title={t("page.settings.title")} lead={t("page.settings.lead")} />
+  <section class="block">
+    <div class="wrap">
+      <h2>{t("page.settings.language")}</h2>
+      <p>
+        {locales.map((x, i) => (
+          <>{i > 0 && " · "}<a href={localePath(x, "/settings")} lang={x} aria-current={x === lang ? "true" : undefined}>{localeNames[x]}</a></>
+        ))}
+      </p>
+    </div>
+  </section>
+</BaseLayout>
diff --git a/src/styles/global.css b/src/styles/global.css
index 7e15ac3..3758bea 100644
--- a/src/styles/global.css
+++ b/src/styles/global.css
@@ -64,3 +64,26 @@ h2 { font-size: 1.4rem; margin: 0 0 1rem; }
 .icon-btn { display: inline-flex; align-items: center; justify-content: center; width: 2.3rem; height: 2.3rem;
   border: 1px solid var(--line); border-radius: 50%; color: inherit; text-decoration: none; }
 .icon-btn:hover { border-color: var(--accent); color: var(--accent); }
+
+/* Account dropdown (header) */
+.account { position: relative; }
+.account .icon-btn { background: #fff; cursor: pointer; padding: 0; font: inherit; }
+.account-dd { right: 0; left: auto; min-width: 180px; }
+.account-dd[hidden] { display: none; }
+.account-dd:not([hidden]) { display: block; }
+.account-dd a, .account-dd button { display: block; width: 100%; text-align: left; padding: .35rem .9rem;
+  border: 0; background: none; font: inherit; color: inherit; text-decoration: none; cursor: pointer; }
+.account-dd a:hover, .account-dd button:hover { background: var(--ph-bg); }
+.if-in { display: none !important; }
+html[data-auth="in"] .if-in { display: block !important; }
+html[data-auth="in"] .if-out { display: none !important; }
+
+/* Connect / account / settings pages */
+.auth-form { display: grid; gap: .8rem; max-width: 360px; }
+.auth-form label { display: grid; gap: .25rem; font-size: .9rem; color: var(--muted); }
+.auth-form input { font: inherit; padding: .5rem .6rem; border: 1px solid var(--line); border-radius: 6px; }
+.auth-form button { font: inherit; padding: .55rem 1rem; border: 1px solid var(--accent); border-radius: 6px;
+  background: var(--accent); color: #fff; cursor: pointer; }
+.kv { display: grid; grid-template-columns: max-content 1fr; gap: .4rem 1.2rem; }
+.kv dt { color: var(--muted); }
+.kv dd { margin: 0; }
